BOSPA_HTTP_ADDR=:8080
BOSPA_DATABASE_URL=postgres://bospa:change-me@localhost:5432/bospa?sslmode=disable
BOSPA_PUBLIC_ORIGIN=http://localhost:4173
BOSPA_ALLOWED_ORIGINS=http://localhost:4173
BOSPA_COOKIE_SECURE=false
BOSPA_SESSION_TTL=720h
BOSPA_AUTO_MIGRATE=true
BOSPA_LOG_LEVEL=info
BOSPA_DB_MAX_CONNS=20
BOSPA_DB_MIN_CONNS=2
BOSPA_DB_MAX_CONN_LIFETIME=30m

# Used only once to bootstrap an empty installation.
BOSPA_BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOSPA_BOOTSTRAP_OWNER_PASSWORD=replace-with-at-least-12-characters
BOSPA_BOOTSTRAP_OWNER_NAME=Владелец Bospa
BOSPA_BOOTSTRAP_WORKSPACE=Bospa Demo
